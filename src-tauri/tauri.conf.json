{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CosmoKaraoke",
  "version": "0.1.17",
  "identifier": "info.cosmonet.cosmokaraoke",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CosmoKaraoke",
        "width": 1360,
        "height": 840,
        "minWidth": 1000,
        "minHeight": 640,
        "maximized": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "category": "Music",
    "shortDescription": "Lettore karaoke",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBBNEUwQ0VCMjIwMTZDNDYKUldSR2JBRWk2d3hPQ2tBS3NaWDN1ZEpsckNWQU5qUTV4K3ZBbVJnem01S3ZpUllpNHV3RGUvcE4K",
      "endpoints": [
        "https://github.com/CosmoNetinfo/CosmoKaraoke/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
